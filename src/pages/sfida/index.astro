---
import Challenge from '@/components/challenge/Challenge';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('ch.title')} description={t('ch.intro')} fit>
  <section class="prose-it mx-auto mb-6 max-w-2xl text-center fit:sr-only">
    <h1>{t('ch.title')}</h1>
    <p class="font-sans text-text-muted">{t('ch.intro')}</p>
  </section>
  <Challenge client:only="react">
    <p slot="fallback" class="text-center text-text-muted">
      {t('ch.loading')}
    </p>
  </Challenge>
  <noscript>
    <p class="text-center">{t('ch.noscript')}</p>
  </noscript>
</BaseLayout>
