---
import Worksheet from '@/components/worksheet/Worksheet';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n';
---

<BaseLayout title={t('ws.title')} description={t('ws.intro')}>
  <section class="prose-it no-print mx-auto mb-6 max-w-3xl text-center">
    <h1>{t('ws.title')}</h1>
    <p class="font-sans text-text-muted">{t('ws.intro')}</p>
  </section>
  <Worksheet client:only="react">
    <p slot="fallback" class="text-center text-text-muted">
      {t('ws.loading')}
    </p>
  </Worksheet>
  <noscript>
    <p class="text-center">{t('ch.noscript')}</p>
  </noscript>
</BaseLayout>
