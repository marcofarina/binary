---
import { t } from '@/i18n';
import { url } from '@/lib/url';
import LimToggle from './LimToggle.astro';
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { href: url('sfida/'), label: t('nav.challenge') },
  { href: url('allenamento/'), label: t('nav.practice') },
  { href: url('teoria/'), label: t('nav.theory') },
  { href: url('docenti/'), label: t('nav.teachers') },
];

const currentPath = Astro.url.pathname;
---

<header class="no-print border-b border-border bg-surface">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 fit:max-w-none fit:py-1">
    <a href={url()} class="flex items-baseline gap-2 font-bold text-text no-underline">
      <span class="font-mono text-xl tracking-widest">BINARY</span>
      <span class="text-sm font-normal text-text-muted">{t('site.project')}</span>
    </a>
    <nav aria-label={t('nav.label')} class="order-last w-full sm:order-none sm:w-auto sm:flex-1">
      <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-text no-underline hover:underline aria-[current=page]:font-semibold aria-[current=page]:text-accent"
              aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="ms-auto flex gap-2 sm:ms-0">
      <LimToggle />
      <ThemeToggle />
    </div>
  </div>
  <div class="flex h-1" aria-hidden="true">
    {[1, 2, 3, 4, 5, 6, 7].map((n) => (
      <span class="flex-1" style={`background: var(--color-rainbow-${n})`} />
    ))}
  </div>
</header>
